{
  "info": {
    "name": "UniFECAF Flix API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    }
  ],
  "item": [
    {
      "name": "1. Listar todos os filmes",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Retorna lista\", () => pm.expect(pm.response.json().filmes).to.be.an(\"array\").that.is.not.empty);"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/v1/controle-filmes/filme",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "controle-filmes",
            "filme"
          ]
        }
      }
    },
    {
      "name": "2. Buscar filme por ID (2)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Nome é Matrix\", () => pm.expect(pm.response.json().filme.nome).to.eql(\"Matrix\"));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/v1/controle-filmes/filme/2",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "controle-filmes",
            "filme",
            "2"
          ]
        }
      }
    },
    {
      "name": "3. Buscar filme por ID inexistente (999)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 404\", () => pm.response.to.have.status(404));",
              ""
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/v1/controle-filmes/filme/999",
          "host": [
            "{{baseUrl}}"
